  +    @staticmethod
  +    def _is_contiguous_subpath(needle, haystack):
  +        """Return True iff `needle` appears as a contiguous sub-list of `haystack`.
  +
  +        SQANTI3 ISM (Incomplete Splice Match) detection: an isoform is an ISM of
  +        another iff its splice sites form a contiguous subpath of the source's
  +        splice sites (order preserved), and the source is strictly longer.
  +
  +        Examples:
  +            needle=[3],      haystack=[1,2,3]    -> True  (5' truncation, RT drop-off)
  +            needle=[1,2],    haystack=[1,2,3]    -> True  (3' truncation, internal priming)
  +            needle=[1,3],    haystack=[1,2,3]    -> False (exon-skipping NIC, not ISM)
  +            needle=[2],      haystack=[1,2,3]    -> True  (internal truncation)
  +        """
  +        n = len(needle)
  +        if n == 0:
  +            return False
  +        h = len(haystack)
  +        if n > h:
  +            return False
  +        # Sliding-window containment test, O(h * n).
  +        for i in range(h - n + 1):
  +            if haystack[i:i + n] == needle:
  +                return True
  +        return False
  +
